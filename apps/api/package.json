{
  "name": "@attendentai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun dist/main.js",
    "drizzle-kit": "node node_modules/drizzle-kit/bin.cjs",
    "typecheck": "bun tsc --noEmit",
    "clear-history": "bun run src/scripts/clear-history.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.0",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.26.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.4.0",
    "openai": "^4.28.0",
    "pino": "^9.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.31.10"
  }
}
