# ============================================
# CONFIGURAÇÃO OBRIGATÓRIA
# ============================================

# API IA — chave principal (OpenAI compatível)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Segurança do webhook (shared secret com o n8n)
WEBHOOK_SECRET=seu_secret_aqui_minimo_32_chars

# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL=file:/data/db.sqlite
SQLITE_JOURNAL_MODE=WAL
# DATABASE_URL=postgresql://user:pass@host:5432/db

# ============================================
# REDIS (fila + cache + locks)
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# MODELOS (configuráveis sem rebuild)
# ============================================
MODEL_ORCHESTRATOR=gpt-4o-mini
MODEL_CLASSIFIER=gpt-4o-mini
MODEL_IDENTIFIER=gpt-4o-mini
MODEL_RESPONDER=gpt-4o
MODEL_SUMMARIZER=gpt-4o-mini
MODEL_MEMORY=gpt-4o-mini

# ============================================
# LIMITES E PERFORMANCE
# ============================================
MAX_TOKENS_RESPONSE=800
MAX_TOKENS_CONTEXT=4000
MAX_MESSAGES_IN_CONTEXT=20
WEBHOOK_TIMEOUT_MS=25000
MAX_CONCURRENT_CHATS=50
LOCK_TTL_SECONDS=30
API_RATE_LIMIT_PER_MINUTE=1000
WEBHOOK_PHONE_RATE_LIMIT_PER_MINUTE=30
BATCH_WINDOW_MS=10000
BATCH_MAX_MESSAGES=10
QUEUE_CONCURRENCY=5
TRACE_RETENTION_DAYS=7

# ============================================
# v2.0 — MCP ENGINE
# ============================================
ENCRYPTION_KEY=          # gerar com: openssl rand -hex 32
MCP_ENABLED=false        # feature flag — manter false até tudo pronto

# ============================================
# v2.0 — GOOGLE CALENDAR OAUTH
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/mcp/google-calendar/auth/callback

# ============================================
# VAULT
# ============================================
VAULT_PATH=/vault
VAULT_COMPACTION_DELAY_MS=30000
VAULT_MAX_SUMMARY_TOKENS=500
VAULT_COMPACTION_MODEL=gpt-4o-mini
VAULT_CRON_SCHEDULE=0 3 * * *

# ============================================
# DASHBOARD
# ============================================
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
API_PORT=3001
DASHBOARD_SECRET=outra_senha_segura
# URL interna da API para Server Components/proxy do dashboard
API_URL=http://api:3001
# URL pública da API para chamadas client-side/WebSocket. Pode ficar vazio se usar o proxy interno.
NEXT_PUBLIC_API_URL=http://api:3001

# ============================================
# ÁUDIO
# ============================================
AUDIO_AUTO_ENABLED=true
AUDIO_ENABLED=true
AUDIO_MAX_CHARS=300
AUDIO_RANDOM_CHANCE=0.20
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ============================================
# EVOLUTION API
# ============================================
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_LOCAL_URL=http://salles-evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ============================================
# REAÇÕES WHATSAPP
# ============================================
REACTIONS_ENABLED=true
REACTIONS_MIN_INTERVAL_MINUTES=30
REACTIONS_ALLOWED_EMOJIS=👍,❤️,🙏,✅,👏,🔥,😊

# ============================================
# OPCIONAL — Anthropic (caso use Claude)
# ============================================
# ANTHROPIC_API_KEY=sk-ant-...
# Se usar Anthropic, ajustar OPENAI_BASE_URL para um proxy OpenAI-compatible
